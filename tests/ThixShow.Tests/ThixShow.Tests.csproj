<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of ThixShow: the real app rendered headless (Avalonia + Skia), driven by real key, text and pointer events: the
    thumbnails, shapes on the slide with snapping, text in placeholders, ribbon state, galleries, sorter, the show and the presenter
    view, print layouts, files, and the snapshots
    (THIXSHOW_SCREENSHOTS=<folder> keeps them – look at them).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThixOffice.Core\ThixOffice.Core.csproj" />
    <ProjectReference Include="..\..\src\ThixOffice.Desktop\ThixOffice.Desktop.csproj" />
    <ProjectReference Include="..\..\src\ThixShow.Core\ThixShow.Core.csproj" />
    <ProjectReference Include="..\..\src\ThixShow\ThixShow.csproj" />
  </ItemGroup>

</Project>
