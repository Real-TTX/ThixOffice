<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of ThixWrite: its definition and document, and the real app rendered headless (Avalonia + Skia): new, open, save,
    save as, "Zuletzt verwendet", the unsaved prompt, recovery, file activation and a second start handing over files, the
    commands of ThixWrite, and the snapshots (THIXWRITE_SCREENSHOTS=<folder> keeps them – look at them).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThixOffice.Core\ThixOffice.Core.csproj" />
    <ProjectReference Include="..\..\src\ThixOffice.Desktop\ThixOffice.Desktop.csproj" />
    <ProjectReference Include="..\..\src\ThixWrite.Core\ThixWrite.Core.csproj" />
    <ProjectReference Include="..\..\src\ThixWrite\ThixWrite.csproj" />
  </ItemGroup>

</Project>
