<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the shared desktop UI, rendered headless with Avalonia + Skia, with a small test app (TestOfficeApp): the
    document window and its parts, the command search, the backstage pages, the keyboard, the unsaved prompt, the slots
    that MatRibbon / MatBackstage / MatStatusBar drop into, no literal colours, the copy of MatDesktop.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThixOffice.Core\ThixOffice.Core.csproj" />
    <ProjectReference Include="..\..\src\ThixOffice.Desktop\ThixOffice.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\thixtest.ico" />
    <AvaloniaResource Include="Assets\logo-256.png" />
    <!-- The install options of the test app ThixTest (the same file as the core tests'). -->
    <EmbeddedResource Include="..\ThixOffice.Core.Tests\installer.json" LogicalName="installer.json" Link="installer.json" />
  </ItemGroup>

</Project>
