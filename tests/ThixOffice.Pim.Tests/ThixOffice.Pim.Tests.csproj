<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of ThixOffice.Pim: the rules of contacts against the shared fixtures (Fixtures/Contacts – the same files as MatCloud's
    tests/MatCloud.Tests/Fixtures/Contacts, so both read and write vCard and CSV alike), the local store (SQLite, migrations), the sync client
    against the ThixCloud in memory (SampleCloud: two computers, conflicts, tombstones, offline, pictures).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThixOffice.Core\ThixOffice.Core.csproj" />
    <ProjectReference Include="..\..\src\ThixOffice.Pim\ThixOffice.Pim.csproj" />
  </ItemGroup>

</Project>