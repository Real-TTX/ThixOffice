<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of ThixContacts.Core: the session of the contacts on a real store (SQLite in a temporary folder) – rules, undo/redo, groups, categories,
    duplicates and merging, import and export with pictures, the query of 50,000 contacts – and the workspace document with its sync.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThixOffice.Core\ThixOffice.Core.csproj" />
    <ProjectReference Include="..\..\src\ThixOffice.Pim\ThixOffice.Pim.csproj" />
    <ProjectReference Include="..\..\src\ThixContacts.Core\ThixContacts.Core.csproj" />
  </ItemGroup>

</Project>