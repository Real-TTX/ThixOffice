<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ThixWrite without UI: its app definition (accent, document types) and its document model. Phase 0 has a trivial plain
    text document so that the shell (new, open, save, recent, recovery) is used end to end; the real model (sections,
    paragraphs, runs, styles), the layout and docx come in phase 1.
  -->
  <PropertyGroup>
    <RootNamespace>ThixWrite.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThixWrite" />
    <InternalsVisibleTo Include="ThixWrite.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThixOffice.Core\ThixOffice.Core.csproj" />
  </ItemGroup>

</Project>
