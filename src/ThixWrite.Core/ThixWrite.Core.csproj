<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ThixWrite without UI: its app definition (accent, document types) and the word processor's core – the document model
    (Model: sections, paragraphs, runs, styles, lists, preserved content), the editing engine (Editing: positions, selection,
    reversible steps, undo, clipboard, find), the layout (Layout: line breaking, pagination, hit testing, page display lists)
    and the formats (Formats: docx with the Open XML SDK, plain text). No UI framework and no native code: text is measured
    through ThixOffice.Text's ITextMeasurer, so the same core can serve a web version.
    PHASE 0 ONLY: Documents/TextDocument (plain text) stays until the native editor replaces the placeholder editor.
  -->
  <PropertyGroup>
    <RootNamespace>ThixWrite.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThixWrite" />
    <InternalsVisibleTo Include="ThixWrite.Desktop" />
    <InternalsVisibleTo Include="ThixMail" />
    <InternalsVisibleTo Include="ThixMail.Core" />
    <InternalsVisibleTo Include="ThixMail.Tests" />
    <InternalsVisibleTo Include="ThixMail.Core.Tests" />
    <InternalsVisibleTo Include="ThixWrite.Tests" />
    <InternalsVisibleTo Include="ThixWrite.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT licence. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThixOffice.Core\ThixOffice.Core.csproj" />
    <ProjectReference Include="..\ThixOffice.Text\ThixOffice.Text.csproj" />
    <ProjectReference Include="..\ThixOffice.Charts\ThixOffice.Charts.csproj" />
  </ItemGroup>

</Project>
