<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mat="using:MatDesktop"
             xmlns:controls="using:ThixOffice.Desktop.Controls"
             xmlns:pages="using:ThixOffice.Desktop.Pages"
             x:Class="ThixOffice.Desktop.Pages.OpenPage">
  <!--
    Datei › Öffnen with places like Word: "Zuletzt verwendet" (the recent list by the house rules for lists: the toolbar above – search,
    sort –, the list – ThixDrive documents with a cloud –, the actions below at the left from positive to negative, "Aus Liste
    entfernen" and "Nicht gefundene entfernen" set apart), "ThixDrive" (the DriveBrowser; hidden for an app without the cloud or under
    the policy DisableCloud) and "Dieser PC" (Durchsuchen: the system's dialog, and the folders used last).
  -->
  <UserControl.Styles>
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="MinWidth" Value="260" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="32,26,32,22">
    <TextBlock DockPanel.Dock="Top" Text="Öffnen" Theme="{StaticResource MatText.PageTitle}" Margin="0,0,0,14" />

    <!-- The places -->
    <ListBox x:Name="Places" DockPanel.Dock="Top" Theme="{StaticResource MatList}" ItemContainerTheme="{StaticResource MatChoiceRow}"
             AutomationProperties.Name="Orte" HorizontalAlignment="Left" Margin="0,0,0,14">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBoxItem x:Name="RecentPlaceItem" AutomationProperties.Name="Zuletzt verwendet">
        <controls:IconLabel Icon="clock" Text="Zuletzt verwendet" />
      </ListBoxItem>
      <ListBoxItem x:Name="DrivePlaceItem" AutomationProperties.Name="ThixDrive">
        <controls:IconLabel Icon="cloud" Text="ThixDrive" />
      </ListBoxItem>
      <ListBoxItem x:Name="ComputerPlaceItem" AutomationProperties.Name="Dieser PC">
        <controls:IconLabel Icon="monitor" Text="Dieser PC" />
      </ListBoxItem>
    </ListBox>

    <Panel>
      <!-- Zuletzt verwendet -->
      <DockPanel x:Name="RecentPlace">
        <!-- Toolbar above the list: search and sort -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10" MaxWidth="900" HorizontalAlignment="Stretch">
          <TextBox x:Name="SearchBox" Theme="{StaticResource MatSearchBox}" Watermark="Zuletzt verwendete Dokumente durchsuchen"
                   AutomationProperties.Name="Zuletzt verwendete Dokumente durchsuchen" MaxWidth="420" HorizontalAlignment="Left" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
            <mat:MatIcon Icon="sort" Size="16" Foreground="{DynamicResource Mat.TextMuted}" VerticalAlignment="Center" />
            <ComboBox x:Name="SortChoice" MinWidth="170" AutomationProperties.Name="Sortieren">
              <ComboBoxItem Content="Zuletzt geöffnet" />
              <ComboBoxItem Content="Name" />
            </ComboBox>
          </StackPanel>
        </Grid>

        <!-- Actions below the list, left-aligned -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <controls:InfoBar x:Name="Message" />
          <controls:ActionBar>
            <Button x:Name="OpenButton" Theme="{StaticResource MatButton.Primary}" Click="OnOpenClick">
              <controls:IconLabel Icon="file-text" Text="Öffnen" />
            </Button>
            <Button x:Name="PinButton" Click="OnPinClick">
              <controls:IconLabel x:Name="PinLabel" Icon="pin" Text="Anheften" />
            </Button>
            <Button x:Name="RevealButton" Click="OnRevealClick">
              <controls:IconLabel Icon="folder" Text="Im Ordner anzeigen" />
            </Button>
            <Button x:Name="RemoveButton" Theme="{StaticResource MatButton.Danger}" controls:ActionBar.Separated="True" Click="OnRemoveClick">
              <controls:IconLabel Icon="x" Text="Aus Liste entfernen" />
            </Button>
            <Button x:Name="RemoveMissingButton" Click="OnRemoveMissingClick">
              <controls:IconLabel Icon="trash" Text="Nicht gefundene entfernen" />
            </Button>
          </controls:ActionBar>
        </StackPanel>

        <Panel MaxWidth="900" HorizontalAlignment="Stretch">
          <TextBlock x:Name="EmptyText" Theme="{StaticResource MatText.Muted}" TextWrapping="Wrap" Margin="4,8" IsVisible="False" />
          <ListBox x:Name="List" Theme="{StaticResource MatList}" ItemContainerTheme="{StaticResource MatCardRow}" AutomationProperties.Name="Zuletzt verwendet">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,2">
                  <mat:MatIcon Icon="{Binding Icon}" Size="22" Foreground="{DynamicResource Mat.Accent}" Margin="0,0,14,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Folder}" Theme="{StaticResource MatText.Muted}" TextTrimming="PrefixCharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="14,0,4,0">
                    <TextBlock Text="{Binding State}" Theme="{StaticResource MatText.Muted}" VerticalAlignment="Center" />
                    <mat:MatIcon Icon="pin" Size="16" IsFilled="True" Foreground="{DynamicResource Mat.Accent}" IsVisible="{Binding IsPinned}" ToolTip.Tip="Angeheftet" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Panel>
      </DockPanel>

      <!-- ThixDrive: the browser is made when the place is chosen -->
      <ContentControl x:Name="DrivePlace" IsVisible="False" />

      <!-- Dieser PC -->
      <ScrollViewer x:Name="ComputerPlace" IsVisible="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" HorizontalAlignment="Left" MaxWidth="900">
          <Button x:Name="BrowseButton" Classes="tile" Click="OnBrowseClick" AutomationProperties.Name="Durchsuchen" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="Auto,*">
              <mat:MatIcon Icon="folder-open" Size="28" Foreground="{DynamicResource Mat.Accent}" Margin="0,0,14,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Durchsuchen" FontWeight="SemiBold" />
                <TextBlock Text="Ein Dokument auf diesem Computer auswählen" Theme="{StaticResource MatText.Muted}" />
              </StackPanel>
            </Grid>
          </Button>
          <StackPanel x:Name="FoldersSection" Spacing="8">
            <TextBlock Text="Zuletzt verwendete Ordner" Theme="{StaticResource MatText.SectionTitle}" Margin="0,8,0,2" />
            <ItemsControl x:Name="Folders">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
