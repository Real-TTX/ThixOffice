<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mat="using:MatDesktop"
             xmlns:controls="using:ThixOffice.Desktop.Controls"
             x:Class="ThixOffice.Desktop.Pages.AboutPage">
  <!-- Datei › Info: reached through the version number at the bottom left of the backstage (house rule). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,26" MaxWidth="660" HorizontalAlignment="Left" Spacing="18">
      <TextBlock x:Name="TitleText" Theme="{StaticResource MatText.PageTitle}" />
      <Border Theme="{StaticResource MatCard}" Padding="24">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="18">
            <Image x:Name="LogoImage" Width="88" Height="88" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <ContentControl x:Name="WordMarkHost" />
              <TextBlock x:Name="TaglineText" Theme="{StaticResource MatText.Muted}" TextWrapping="Wrap" MaxWidth="440" />
              <SelectableTextBlock x:Name="VersionText" FontSize="13" />
            </StackPanel>
          </StackPanel>
          <Border Theme="{StaticResource MatCard}" Background="{DynamicResource Mat.Surface2}" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <mat:MatIcon Size="20" x:Name="UpdateIcon" Icon="download" Margin="0,0,12,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" />
                <TextBlock x:Name="UpdateText" Theme="{StaticResource MatText.Muted}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" x:Name="UpdateButton" Click="OnUpdateClick" Margin="12,0,0,0" VerticalAlignment="Center">
                <controls:IconLabel x:Name="UpdateLabel" Icon="download" Text="Updates …" />
              </Button>
            </Grid>
          </Border>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <TextBlock Text="Kanal" Theme="{StaticResource MatText.Muted}" Margin="0,3,24,3" />
            <TextBlock Grid.Column="1" x:Name="ChannelText" Margin="0,3" />
            <TextBlock Grid.Row="1" Text="Build" Theme="{StaticResource MatText.Muted}" Margin="0,3,24,3" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="BuildText" Margin="0,3" />
            <TextBlock Grid.Row="2" Text="Dokumenttypen" Theme="{StaticResource MatText.Muted}" Margin="0,3,24,3" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TypesText" Margin="0,3" TextWrapping="Wrap" />
            <TextBlock Grid.Row="3" Text="System" Theme="{StaticResource MatText.Muted}" Margin="0,3,24,3" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SystemText" Margin="0,3" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Text="Daten" Theme="{StaticResource MatText.Muted}" Margin="0,3,24,3" />
            <SelectableTextBlock Grid.Row="4" Grid.Column="1" x:Name="DataText" Margin="0,3" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Text="© Matthias Schmoldt. Teil von ThixOffice. Symbole: MatDesign (Lucide, ISC-Lizenz)." Theme="{StaticResource MatText.Faint}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <controls:ActionBar>
        <Button Click="OnBackClick" Theme="{StaticResource MatButton.Primary}">
          <controls:IconLabel Icon="back" Text="Zurück zum Dokument" />
        </Button>
        <Button Click="OnGitHubClick">
          <controls:IconLabel Icon="external" Text="Projekt auf GitHub" />
        </Button>
      </controls:ActionBar>
    </StackPanel>
  </ScrollViewer>
</UserControl>
