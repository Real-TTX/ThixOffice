<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ThixContacts.App"
             Name="ThixContacts"
             RequestedThemeVariant="Default">
  <!--
    The look is MatDesktop's (ThixOffice.Desktop/MatDesktop, copied from MatDesign): OfficeApplication.Initialize installs its theme with
    ThixContacts' accent (ThixContactsApp.Accent); the window takes the app's icon from it.
  -->
</Application>