<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ThixWrite.App"
             Name="ThixWrite"
             RequestedThemeVariant="Default">
  <!--
    The look is MatDesktop's (ThixOffice.Desktop/MatDesktop, copied from MatDesign): OfficeApplication.Initialize installs
    its theme with ThixWrite's accent (ThixWriteApp.Accent) – Fluent in the colours of the tokens, a brush per token in light and dark,
    the control themes, the icons of the sprite; every window takes the app's icon from it.
  -->
</Application>
