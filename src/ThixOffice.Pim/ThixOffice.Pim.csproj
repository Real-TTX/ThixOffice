<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ThixOffice.Pim: what ThixContacts and (later) ThixMail share, without UI: the person (a contact with its key, its data – the contract's
    ContactData – and its time), the rules of contacts (Rules: normalize, validate, fold, sort, duplicates and merge, vCard 2.1/3.0/4.0, CSV –
    the same rules as MatCloud's module Contacts, held together by the shared fixtures in tests/ThixOffice.Pim.Tests/Fixtures/Contacts), the
    local store (Store: one SQLite file per app and account, schema migrations by version, the items of the general sync, the pictures, a
    cursor) and the sync client of MatCloud's general sync (Sync: push the changes of this computer, pull the others' with the cursor, the
    last writer wins, tombstones, an offline queue, retry, a background loop with long polls).
  -->
  <PropertyGroup>
    <RootNamespace>ThixOffice.Pim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThixOffice.Pim.Desktop" />
    <InternalsVisibleTo Include="ThixOffice.Pim.Tests" />
    <InternalsVisibleTo Include="ThixContacts" />
    <InternalsVisibleTo Include="ThixMail" />
    <InternalsVisibleTo Include="ThixMail.Core" />
    <InternalsVisibleTo Include="ThixMail.Tests" />
    <InternalsVisibleTo Include="ThixMail.Core.Tests" />
    <InternalsVisibleTo Include="ThixContacts.Core" />
    <InternalsVisibleTo Include="ThixContacts.Core.Tests" />
    <InternalsVisibleTo Include="ThixContacts.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT licence; brings SQLitePCLRaw with the native e_sqlite3 of every platform (win-x64, osx-arm64, osx-x64). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThixOffice.Core\ThixOffice.Core.csproj" />
  </ItemGroup>

</Project>
