<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ThixOffice.Pim.Desktop: the views ThixContacts and ThixMail share, on Avalonia and MatDesktop: the avatar of a person (picture or initials), the person
    card, the address field with suggestions; People/ = Outlook's "Personen" as ONE code base for ThixContacts' window and ThixMail's view (PeopleView:
    folders, list with search and letters, card; PeopleCommands, PeopleRibbon, the contact dialogs) on ThixContacts.Core's session; Calendar/ = the
    calendar views (day, work week, week, month) and the appointment dialog on ThixOffice.Pim's CalendarBook. Colours only from MatDesktop's tokens
    (the calendars' own colours are user data: CalendarPalette is the one file with literal colours), icons only from its sprite.
  -->
  <PropertyGroup>
    <RootNamespace>ThixOffice.Pim.Desktop</RootNamespace>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThixContacts" />
    <InternalsVisibleTo Include="ThixMail" />
    <InternalsVisibleTo Include="ThixMail.Core" />
    <InternalsVisibleTo Include="ThixMail.Tests" />
    <InternalsVisibleTo Include="ThixMail.Core.Tests" />
    <InternalsVisibleTo Include="ThixContacts.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThixOffice.Core\ThixOffice.Core.csproj" />
    <ProjectReference Include="..\ThixOffice.Desktop\ThixOffice.Desktop.csproj" />
    <ProjectReference Include="..\ThixOffice.Pim\ThixOffice.Pim.csproj" />
    <ProjectReference Include="..\ThixContacts.Core\ThixContacts.Core.csproj" />
  </ItemGroup>

</Project>
