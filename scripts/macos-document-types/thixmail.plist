  <!--
    ThixMail's document types for Finder (CFBundleDocumentTypes, put into Info.plist by package-macos.sh). ThixMail is a workspace app: a saved
    message (.eml, com.apple.mail.email / public.email-message) opened with it shows in a window of its own, read-only. "Viewer" and "Alternate": it
    appears under "Öffnen mit" and never takes .eml from Apple Mail silently (it becomes the default only when the user chooses it). @DOCUMENT_ICON@
    is the document icon of the bundle.
  -->
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>E-Mail-Nachricht</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>eml</string></array>
      <key>LSItemContentTypes</key>
      <array><string>com.apple.mail.email</string><string>public.email-message</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>message/rfc822</string></array>
      <key>CFBundleTypeIconFile</key>
      <string>@DOCUMENT_ICON@</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
    </dict>
  </array>
